# 운영(production) 설정 — 운영 서버에서 backend/.env.production 으로 복사해서 쓴다.
# 이 파일은 ENVIRONMENT=production 이 프로세스 환경변수로 주어졌을 때만 읽힌다
# (systemd unit 의 Environment=ENVIRONMENT=production).
# 개발용 .env 와 겹쳐 읽지 않는다 — 여기 없는 키는 개발 값으로 채워지지 않고 기본값/오류가 된다.

# ── RDS PostgreSQL ─────────────────────────────────────────────────────────
# RDS 에 vector · btree_gist 확장이 필요하다(alembic 0006 · 0010).
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<rds-endpoint>:5432/<db>

# ── Neo4j Aura ─────────────────────────────────────────────────────────────
# 2026-09-24 이전 개발 .env 에 들어 있던 Aura 값 3줄을 그대로 옮기면 된다.
NEO4J_URI=neo4j+s://<id>.databases.neo4j.io
NEO4J_USER=
NEO4J_PASSWORD=

# ── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano

# ── 공공 API ───────────────────────────────────────────────────────────────
KMA_API_KEY=
KOSHA_API_KEY=
PORT_MIS_API_KEY=
MOF_API_KEY=

# ── 하역 개시 인터락 게이트 (MQTT) ─────────────────────────────────────────
# 운영에서 브로커를 어디에 둘지는 미정. 브로커가 없어도 앱은 뜬다.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 운영에서는 * 금지(기동 시 오류). frontend 를 같은 도메인 nginx 뒤에 두면 비워 둔다.
CORS_ORIGINS=
ENABLE_SCHEDULER=true
