# 개발(development) 설정 — backend/.env 로 복사해서 쓴다.
# 운영 설정은 .env.production.example 참고. 어느 파일을 읽을지는 이 파일이 아니라
# 프로세스 환경변수 ENVIRONMENT 로 정한다(미지정 시 development → 이 파일).
#
# ── 기존 .env 에서 바꿀 것 (2026-09-24 환경 분리) ──────────────────────────
#  1. NEO4J_URI 가 Aura(neo4j+s://...databases.neo4j.io)로 되어 있으면 로컬로 바꾼다.
#       NEO4J_URI=bolt://localhost:7687
#       NEO4J_USER / NEO4J_PASSWORD 는 로컬 컨테이너 계정으로.
#     원래 Aura 값 3줄은 버리지 말고 운영 서버의 .env.production 으로 옮긴다.
#     ※ docker-compose.dev.yml 은 같은 NEO4J_USER/NEO4J_PASSWORD 로 컨테이너 계정을
#       만든다. 다만 이 계정은 볼륨이 처음 만들어질 때만 적용되므로, 이미 만든
#       neo4j_data 볼륨이 있으면 그때의 비밀번호를 써야 한다.
#     ※ 로컬 Neo4j 가 비어 있을 수 있다 — data-pipeline 의 Neo4j 로더를 한 번 돌릴 것.
#  2. ENVIRONMENT=development 줄은 있어도 되고 지워도 된다. production 으로 적으면
#     기동 오류가 난다(ENVIRONMENT 는 프로세스 환경변수로만 지정).
#  3. CORS_ORIGINS · ENABLE_SCHEDULER · MQTT_* 는 없으면 기본값(*, true, 127.0.0.1:1883)
#     이라 추가하지 않아도 된다.
#  4. 나머지(DATABASE_URL · POSTGRES_* · API 키)는 그대로.

# ── 로컬 인프라 (docker compose -f docker-compose.dev.yml up -d) ──────────
# POSTGRES_* 는 docker compose 가 컨테이너를 만들 때 읽는다.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# 호스트 포트는 5432 가 아니라 5433
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5433/<db>
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── LLM ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# LLM_PROVIDER: gemini | openai
LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-nano

# ── 공공 API ───────────────────────────────────────────────────────────────
KMA_API_KEY=
KOSHA_API_KEY=
PORT_MIS_API_KEY=
MOF_API_KEY=

# ── 하역 개시 인터락 게이트 (MQTT) ─────────────────────────────────────────
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# ── 동작 ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# 쉼표 구분. 개발은 * 허용
CORS_ORIGINS=*
ENABLE_SCHEDULER=true
